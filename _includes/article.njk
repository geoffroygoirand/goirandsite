<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="{{ description }}">
  <title>{{ title }} | Geoffroy Goirand</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="alternate" type="application/atom+xml" title="Flux du blog" href="/feed.xml">
</head>
<body>
<header class="site-header">
  <a class="brand" href="/index.html"><span class="brand-mark">GG</span><span><strong>Geoffroy Goirand</strong><small>Avocat</small></span></a>
  <nav class="article-nav"><a href="/blog.html">← Retour au blog</a><a href="/index.html#contact">Contacter le cabinet</a></nav>
</header>
<main class="section article-page">
  <p class="eyebrow">{{ category }}</p>
  <h1>{{ title }}</h1>
  <div class="article-meta article-page-meta"><time datetime="{{ date | htmlDate }}">{{ date | dateFr }}</time></div>
  {% if image %}<img class="article-cover" src="{{ image }}" alt="{{ image_alt or title }}">{% endif %}
  {% if description %}<p class="lead">{{ description }}</p>{% endif %}
  <div class="article-content">{{ content | safe }}</div>
  <p><a class="button primary" href="/index.html#contact">Présenter votre situation</a></p>
</main>
<footer><div><strong>Maître Geoffroy Goirand</strong><span>Avocat en droit social et droit immobilier</span></div><div class="footer-links"><a href="/mentions-legales.html">Mentions légales</a><a href="/index.html">Accueil</a></div></footer>
</body>
</html>
